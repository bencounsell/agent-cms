{
  "name": "agentcms",
  "version": "0.1.0",
  "description": "Agent-first headless CMS. Content as files, static output, operated entirely through MCP, CLI and HTTP API.",
  "keywords": [
    "cms",
    "mcp",
    "ai-agents",
    "headless-cms",
    "static",
    "seo",
    "aeo",
    "markdown"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "agentcms": "./bin/agentcms.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "schemas",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch src/cli/main.ts",
    "cli": "node src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "schema": "node -e \"import('./src/core/config/schema.ts').then(async m=>{const {z}=await import('zod');const s=z.toJSONSchema(m.CmsConfigSchema,{io:'input'});s.$schema='https://json-schema.org/draft/2020-12/schema';s.title='agentcms configuration';require('fs').writeFileSync('schemas/config.schema.json',JSON.stringify(s,null,2)+'\\n')})\"",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "minisearch": "^7.2.0",
    "picocolors": "^1.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.0.0"
}
