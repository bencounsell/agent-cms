{%- comment -%}
  Base layout: the <html> shell every page extends.
  Variables: site, theme, page, assets, head, build.
  {{ head | raw }} must stay inside <head>: it carries the title, description, canonical,
  Open Graph, Twitter card, JSON-LD and feed links generated by the CMS.
{%- endcomment -%}
<!doctype html>
<html lang="{{ page.language | default: site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{ head | raw }}
  <link rel="stylesheet" href="{{ assets['styles.css'] }}">
  {% if theme.features.search %}<script defer src="{{ assets['search.js'] }}"></script>{% endif %}
</head>
<body class="page-{{ page.kind }}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/nav" %}
  <main id="main" class="container">
    {% block content %}{% endblock %}
  </main>
  {% include "partials/footer" %}
</body>
</html>
